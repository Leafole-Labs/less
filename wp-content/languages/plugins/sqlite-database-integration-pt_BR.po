#: wp-includes/sqlite/install-functions.php:135
msgid "<strong><em>Note that password</em></strong> carefully! It is a <em>random</em> password that was generated just for you."
msgstr "<strong><em>Anote esta senha</em></strong> com atenção! É uma senha <em>aleatória</em> que foi gerada apenas para você."

#: admin-page.php:99
msgid "All checks completed successfully, your site can use an SQLite database. You can proceed with the installation."
msgstr "Todas as verificações foram concluídas, seu site pode usar um banco de dados SQLite. Você pode prosseguir com a instalação."

#: admin-page.php:119
msgid "By clicking the button below, you will be redirected to the WordPress installation screen to setup your new database"
msgstr "Ao clicar no botão abaixo, você será redirecionado para a tela de instalação do WordPress para configurar seu novo banco de dados"

